# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example is documentation (no secrets) — keep it in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pipeline artifacts
# Keep episode metadata + extracted theses + aggregated holdings (small, only
# short attributed excerpts). Exclude full transcripts (large + copyright):
# they're kept locally for analysis but never published.
data/**/transcript.json

# local agent tooling + pipeline state
.claude/
data/.reextract-pending.json

# Local daily-price cache for --frozen rebuilds (seeded per-machine)
data/prices/

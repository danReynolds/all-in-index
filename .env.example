# Copy to .env and fill in. Never commit .env (it's gitignored).

# AssemblyAI — transcription + speaker diarization.
# Get a key at https://www.assemblyai.com (free tier ≈ 185 hrs of audio).
ASSEMBLYAI_API_KEY=

# Anthropic — speaker naming + thesis extraction + synthesis.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Public site URL — base for canonical, Open Graph, and sitemap absolute URLs.
# Set this in the production (Vercel) environment. Falls back to
# https://allindex.fyi if unset, so a wrong/empty value silently breaks social
# previews and the sitemap — pin it explicitly in prod.
NEXT_PUBLIC_SITE_URL=https://allindex.fyi

# Optional overrides
# EXTRACTION_MODEL=claude-sonnet-4-6
# ALLIN_FEED_URL=https://rss.libsyn.com/shows/254861/destinations/1928300.xml

# Optional X publishing credentials. Draft generation does not need these.
# Prefer OAuth 1.0a user-context tokens for GitHub Actions publishing because
# they do not require refresh-token rotation inside CI.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# Fallback for short-lived/manual OAuth2 user access tokens:
# X_BEARER_TOKEN=
